# Copy this file to config/.env and fill in real values for the target
# environment. config/.env is git-ignored and must never be committed.

APP_NAME="Fetchpoint"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=UTC

# Hostinger: DB_HOST is almost always "localhost". DB_DATABASE and
# DB_USERNAME are auto-prefixed by hPanel (e.g. u123456789_fetchpoint,
# u123456789_fpuser) — copy them exactly as hPanel → Databases shows them.
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

# A long random string, unique to this deployment — used to salt visitor
# IP hashing (app/Analytics/RequestRecorder.php) so it can't be brute-
# forced back to a raw IP. Generate one with:
#   php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
IP_HASH_SALT=

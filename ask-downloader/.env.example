# ADMIN_EMAIL / ADMIN_PASSWORD: Login credentials for the admin dashboard.
# Set these as Environment Variables in Hostinger's hPanel (Deployments ->
# Settings and redeploy -> Environment Variables). Without these set, the
# admin login will refuse everyone.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-this-password"

# MySQL connection for request tracking (server/db.ts). Set these in
# Hostinger's hPanel -> Environment Variables for production. If left
# unset, tracking is automatically disabled and the downloader itself
# keeps working normally.
DB_HOST="localhost"
DB_PORT="3306"
DB_USER="your_mysql_username"
DB_PASSWORD="your_mysql_password"
DB_NAME="your_mysql_database_name"

# FASTSAVER_API_KEY: Optional. Instagram extraction tries several free
# methods first; if all of them fail, it falls back to the hosted
# FastSaverAPI service (api.fastsaver.io) as a last resort. Get a free
# key (1,000 free credits, no card) at https://api.fastsaver.io/auth.
# If this is left unset, that fallback is simply skipped — nothing breaks.
FASTSAVER_API_KEY="fs_sk_your_key_here"

# SAVERAPI_KEY: Optional. A second, independent hosted downloader API
# (saverapi.net). It's tried after the platform's own free methods (and,
# for most platforms, after FastSaverAPI) both fail. It's the ONLY paid
# fallback for Reddit and Dailymotion, since FastSaverAPI doesn't support
# those two. Not used for Threads or LinkedIn (unsupported there either).
# If left unset, this fallback is simply skipped — nothing breaks.
SAVERAPI_KEY="sk_your_key_here"

# yt-dlp (optional). Upload yt-dlp_linux.part1..N to this site's folder or
# its public_html via File Manager; the app joins and verifies them at start.
# YTDLP_DIR: optional custom folder to look in. YTDLP_DISABLED=1 turns it off.
# YTDLP_DIR=""
# YTDLP_DISABLED="1"

# MYMEMORY_EMAIL: Optional but recommended. Text the admin writes in
# Content Editor -> Pages (About, Contact, Privacy, Terms, Legal) is
# machine-translated into every site language by MyMemory (free, no card).
# With an email the site gets its own daily allowance (about 50,000
# characters); without one it shares the allowance of everyone on the same
# server address. Translation runs only when the admin saves, never per visitor.
MYMEMORY_EMAIL="you@example.com"

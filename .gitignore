# WordPress core and uploads are never part of this repository — only the
# custom theme and plugin are.
/wp-admin/
/wp-includes/
/wp-content/uploads/
/wp-content/upgrade/
/wp-content/cache/
/wp-config.php
*.log

# OS / editor noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Installable ZIPs are built on demand from wp-content/ — regenerate with:
#   cd wp-content/plugins && zip -rq ../../dist/haven-realty-core.zip haven-realty-core
#   cd wp-content/themes  && zip -rq ../../dist/haven-realty.zip haven-realty
/dist/

# --- Media Utility Platform (docs/media-platform) ---
# Runtime/writable and dependency directories — never committed. Structure
# is preserved with .gitkeep; contents are environment-specific or generated.
/vendor/
/.env
/config/.env
/storage/cache/*
!/storage/cache/.gitkeep
/storage/logs/*
!/storage/logs/.gitkeep
/storage/tmp/*
!/storage/tmp/.gitkeep
/.phpunit.cache/
composer.phar
